{
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo run *)",
      "Bash(cargo deny *)",
      "Bash(cargo tree *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q '\\.rs\"' && cd \"$CLAUDE_PROJECT_DIR\" && cargo fmt --all 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
